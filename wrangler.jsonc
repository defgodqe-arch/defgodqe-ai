{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "DefGameRoomSqlite" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DefGameRoomSqlite"] }
  ],
  "upload_source_maps": true
}
